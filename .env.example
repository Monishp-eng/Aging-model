# Application Environment: 'development' | 'preview' | 'production' | 'test'
APP_ENV=development

# Canonical Application URL (e.g. http://localhost:3000 or https://extrapolate.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Local Webhook Tunnel URL (e.g. Cloudflare tunnel or ngrok)
# Run `npm run tunnel` to expose localhost:3000 and receive external webhooks from Replicate
# TUNNEL_URL=https://your-tunnel-subdomain.trycloudflare.com

# Database configuration (SQLite via @libsql/client)
DATABASE_URL=file:./data/extrapolate.db

# Supabase Auth & Storage configuration (used for OAuth sessions and blob storage)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Stripe configuration (optional for billing/credits checkout)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_SECRET_KEY_TEST=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_WEBHOOK_SECRET_TEST=whsec_placeholder

# Replicate configuration (AI prediction pipeline)
REPLICATE_API_TOKEN=r8_placeholder
REPLICATE_WEBHOOK_SECRET=whsec_placeholder

# Secret for scheduled cron endpoints (/api/cron/cleanup and /api/cron/reconcile)
CRON_SECRET=super_secret_cron_token

# Observability & Logging
LOG_LEVEL=info
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
RELEASE_VERSION=0.1.0
